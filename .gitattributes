# 统一换行，避免 Windows 上把 shell 脚本的 LF 改成 CRLF
* text=auto eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.srt text eol=lf
*.vtt text eol=lf

# 二进制，不做换行转换
*.png binary
*.jpg binary
*.zip binary
*.wav binary
*.mp4 binary
*.model binary
